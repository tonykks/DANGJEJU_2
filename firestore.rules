rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/favorites/{placeId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasAll(['placeId', 'createdAt'])
        && request.resource.data.keys().hasOnly(['placeId', 'createdAt'])
        && request.resource.data.placeId is string
        && request.resource.data.placeId == placeId
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == request.time;
    }

    match /places/{placeId} {
      allow read: if true;
      allow write: if false;

      // Preserve the existing public reads of canonical catalog provenance.
      match /sources/{sourceId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // Collection-group reads for catalog join. Client queries MUST constrain
    // source == 'KTO' and placeId to values matching this regex (rules ≠ filters).
    match /{path=**}/sources/{sourceId} {
      allow read: if resource.data.source == 'KTO'
        && resource.data.placeId.matches('^kto-[0-9]+$');
      allow write: if false;
    }

    // Includes user profile documents and any unimplemented collections.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
