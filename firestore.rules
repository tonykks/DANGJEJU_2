rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isActiveAdmin() {
      return request.auth != null && isActiveAdminUid(request.auth.uid);
    }

    function isActiveAdminUid(uid) {
      let adminPath = /databases/$(database)/documents/admins/$(uid);
      let admin = get(adminPath).data;
      return exists(adminPath)
        && admin.role == 'admin'
        && admin.active == true;
    }

    function validTriStates(values) {
      return values.hasOnly(['TRUE', 'FALSE', 'UNKNOWN']);
    }

    function optionalText(data, key, maxLength) {
      return !(key in data) || data[key] == null || (data[key] is string && data[key].size() <= maxLength);
    }

    function optionalList(data, key, maxSize) {
      return !(key in data) || data[key] == null || (data[key] is list && data[key].size() <= maxSize);
    }

    function optionalHttpUrl(data, key) {
      return !(key in data) || data[key] == null || data[key] == ''
        || (data[key] is string && data[key].size() <= 500 && data[key].matches('^https?://.+$'));
    }

    function optionalInstagramUrl(data, key) {
      return !(key in data) || data[key] == null || data[key] == ''
        || (data[key] is string && data[key].size() <= 500
          && data[key].matches('^https?://([A-Za-z0-9-]+\\.)*instagram\\.com([/:?#].*)?$'));
    }

    function validPetPolicy(data) {
      let policy = data.petPolicy;
      let allowedBreeds = policy.allowedBreeds;
      let allowedSizes = policy.allowedSizes;
      let sizeDescription = policy.sizeDescription;
      let spacePolicy = policy.spacePolicy;
      let spaceDescription = policy.spaceDescription;
      let leashDescription = policy.leashDescription;
      let petFee = policy.petFee;
      let petFeeDescription = policy.petFeeDescription;
      let nullableValues = [
        allowedBreeds, allowedSizes, sizeDescription, spacePolicy, spaceDescription,
        leashDescription, petFee, petFeeDescription, policy.otherPetPolicy
      ];
      return [
          policy is map,
          policy.size() == 19,
          policy.petInformationStatus in ['KTO_OVERLAY_FOUND', 'ADMIN_CONFIRMED', 'UNKNOWN'],
          validTriStates([
          policy.petAcceptance, policy.smallDogAllowed, policy.mediumDogAllowed,
          policy.largeDogAllowed, policy.indoorAllowed, policy.outdoorAllowed,
          policy.carrierRequired, policy.leashRequired, policy.offLeashZoneAvailable
        ]),
          (nullableValues.hasOnly([null]) || (
          !nullableValues.hasAny([null]) ? ([
          allowedBreeds is list,
          allowedBreeds.size() <= 30,
          allowedSizes is list,
          allowedSizes.size() <= 30,
          sizeDescription.matches('(?s)^.{0,1000}.{0,1000}.{0,1000}.{0,1000}$'),
          spacePolicy.matches('(?s)^.{0,500}$'),
          spaceDescription.matches('(?s)^.{0,1000}.{0,1000}.{0,1000}.{0,1000}$'),
          leashDescription.matches('(?s)^.{0,1000}.{0,1000}.{0,1000}.{0,1000}$'),
          petFee is int,
          petFee >= 0,
          petFee <= 1000000,
          petFeeDescription.matches('(?s)^.{0,1000}.{0,1000}.{0,1000}.{0,1000}$'),
          policy.otherPetPolicy.matches('(?s)^.{0,1000}.{0,1000}.{0,1000}.{0,1000}$')
        ].hasOnly([true])) : ([
            allowedBreeds == null || (allowedBreeds is list && allowedBreeds.size() <= 30),
            allowedSizes == null || (allowedSizes is list && allowedSizes.size() <= 30),
            sizeDescription == null || (sizeDescription.matches('(?s)^.{0,1000}.{0,1000}.{0,1000}.{0,1000}$')),
            spacePolicy == null || (spacePolicy.matches('(?s)^.{0,500}$')),
            spaceDescription == null || (spaceDescription.matches('(?s)^.{0,1000}.{0,1000}.{0,1000}.{0,1000}$')),
            leashDescription == null || (leashDescription.matches('(?s)^.{0,1000}.{0,1000}.{0,1000}.{0,1000}$')),
            petFeeDescription == null || (petFeeDescription.matches('(?s)^.{0,1000}.{0,1000}.{0,1000}.{0,1000}$')),
            policy.otherPetPolicy == null || (policy.otherPetPolicy.matches('(?s)^.{0,1000}.{0,1000}.{0,1000}.{0,1000}$')),
            petFee == null || (petFee is int && petFee >= 0 && petFee <= 1000000)
          ].hasOnly([true]))
        ))
        ].hasOnly([true]);
    }

    function validAmenities(data) {
      let amenity = data.amenities;
      let parkingDescription = amenity.parkingDescription;
      return [
          amenity is map,
          amenity.size() == 7,
          validTriStates([
          amenity.freeParking, amenity.dogMenu, amenity.waterBowlProvided,
          amenity.wasteBagsProvided, amenity.fencedYard, amenity.photoZone
        ]),
          ((parkingDescription is string
          && parkingDescription.matches('(?s)^.{0,1000}.{0,1000}.{0,1000}.{0,1000}$'))
          || parkingDescription == null)
        ].hasOnly([true]);
    }

    function validPetDetails(details) {
      return details is map
        && details.keys().hasOnly([
          'acmpyTypeCd', 'acmpyNeedMtr', 'acmpyPsblCpam', 'etcAcmpyInfo',
          'relaAcdntRiskMtr', 'relaFrnshPrdlst', 'relaPosesFclty',
          'relaPurcPrdlst', 'relaRntlPrdlst'
        ])
        && (details.size() == 9
          ? validCompletePetDetails(details)
          : validSparsePetDetails(details));
    }

    function validSparsePetDetails(details) {
      let acmpyTypeCd = details.get('acmpyTypeCd', null);
      let acmpyNeedMtr = details.get('acmpyNeedMtr', null);
      let acmpyPsblCpam = details.get('acmpyPsblCpam', null);
      let etcAcmpyInfo = details.get('etcAcmpyInfo', null);
      let relaAcdntRiskMtr = details.get('relaAcdntRiskMtr', null);
      let relaFrnshPrdlst = details.get('relaFrnshPrdlst', null);
      let relaPosesFclty = details.get('relaPosesFclty', null);
      let relaPurcPrdlst = details.get('relaPurcPrdlst', null);
      let relaRntlPrdlst = details.get('relaRntlPrdlst', null);
      return [
        acmpyTypeCd == null || acmpyTypeCd.matches('(?s)^.{0,1000}.{0,1000}.{0,1000}.{0,1000}$'),
        acmpyNeedMtr == null || acmpyNeedMtr.matches('(?s)^.{0,1000}.{0,1000}.{0,1000}.{0,1000}$'),
        acmpyPsblCpam == null || acmpyPsblCpam.matches('(?s)^.{0,1000}.{0,1000}.{0,1000}.{0,1000}$'),
        etcAcmpyInfo == null || etcAcmpyInfo.matches('(?s)^.{0,1000}.{0,1000}.{0,1000}.{0,1000}$'),
        relaAcdntRiskMtr == null || relaAcdntRiskMtr.matches('(?s)^.{0,1000}.{0,1000}.{0,1000}.{0,1000}$'),
        relaFrnshPrdlst == null || relaFrnshPrdlst.matches('(?s)^.{0,1000}.{0,1000}.{0,1000}.{0,1000}$'),
        relaPosesFclty == null || relaPosesFclty.matches('(?s)^.{0,1000}.{0,1000}.{0,1000}.{0,1000}$'),
        relaPurcPrdlst == null || relaPurcPrdlst.matches('(?s)^.{0,1000}.{0,1000}.{0,1000}.{0,1000}$'),
        relaRntlPrdlst == null || relaRntlPrdlst.matches('(?s)^.{0,1000}.{0,1000}.{0,1000}.{0,1000}$')
      ].hasOnly([true]);
    }

    function validCompletePetDetails(details) {
      let acmpyTypeCd = details.acmpyTypeCd;
      let acmpyNeedMtr = details.acmpyNeedMtr;
      let acmpyPsblCpam = details.acmpyPsblCpam;
      let etcAcmpyInfo = details.etcAcmpyInfo;
      let relaAcdntRiskMtr = details.relaAcdntRiskMtr;
      let relaFrnshPrdlst = details.relaFrnshPrdlst;
      let relaPosesFclty = details.relaPosesFclty;
      let relaPurcPrdlst = details.relaPurcPrdlst;
      let relaRntlPrdlst = details.relaRntlPrdlst;
      let hasNull = details.values().hasAny([null]);
      return [acmpyTypeCd, acmpyNeedMtr, acmpyPsblCpam, etcAcmpyInfo, relaAcdntRiskMtr,
        relaFrnshPrdlst, relaPosesFclty, relaPurcPrdlst, relaRntlPrdlst].hasOnly(['']) || (!hasNull ? ([
          acmpyTypeCd.matches('(?s)^.{0,1000}.{0,1000}.{0,1000}.{0,1000}$'),
          acmpyNeedMtr.matches('(?s)^.{0,1000}.{0,1000}.{0,1000}.{0,1000}$'),
          acmpyPsblCpam.matches('(?s)^.{0,1000}.{0,1000}.{0,1000}.{0,1000}$'),
          etcAcmpyInfo.matches('(?s)^.{0,1000}.{0,1000}.{0,1000}.{0,1000}$'),
          relaAcdntRiskMtr.matches('(?s)^.{0,1000}.{0,1000}.{0,1000}.{0,1000}$'),
          relaFrnshPrdlst.matches('(?s)^.{0,1000}.{0,1000}.{0,1000}.{0,1000}$'),
          relaPosesFclty.matches('(?s)^.{0,1000}.{0,1000}.{0,1000}.{0,1000}$'),
          relaPurcPrdlst.matches('(?s)^.{0,1000}.{0,1000}.{0,1000}.{0,1000}$'),
          relaRntlPrdlst.matches('(?s)^.{0,1000}.{0,1000}.{0,1000}.{0,1000}$')
        ].hasOnly([true])) : (
        ((acmpyTypeCd is string && acmpyTypeCd.matches('(?s)^.{0,1000}.{0,1000}.{0,1000}.{0,1000}$')) || acmpyTypeCd == null)
        && ((acmpyNeedMtr is string && acmpyNeedMtr.matches('(?s)^.{0,1000}.{0,1000}.{0,1000}.{0,1000}$')) || acmpyNeedMtr == null)
        && ((acmpyPsblCpam is string && acmpyPsblCpam.matches('(?s)^.{0,1000}.{0,1000}.{0,1000}.{0,1000}$')) || acmpyPsblCpam == null)
        && ((etcAcmpyInfo is string && etcAcmpyInfo.matches('(?s)^.{0,1000}.{0,1000}.{0,1000}.{0,1000}$')) || etcAcmpyInfo == null)
        && ((relaAcdntRiskMtr is string && relaAcdntRiskMtr.matches('(?s)^.{0,1000}.{0,1000}.{0,1000}.{0,1000}$')) || relaAcdntRiskMtr == null)
        && ((relaFrnshPrdlst is string && relaFrnshPrdlst.matches('(?s)^.{0,1000}.{0,1000}.{0,1000}.{0,1000}$')) || relaFrnshPrdlst == null)
        && ((relaPosesFclty is string && relaPosesFclty.matches('(?s)^.{0,1000}.{0,1000}.{0,1000}.{0,1000}$')) || relaPosesFclty == null)
        && ((relaPurcPrdlst is string && relaPurcPrdlst.matches('(?s)^.{0,1000}.{0,1000}.{0,1000}.{0,1000}$')) || relaPurcPrdlst == null)
        && ((relaRntlPrdlst is string && relaRntlPrdlst.matches('(?s)^.{0,1000}.{0,1000}.{0,1000}.{0,1000}$')) || relaRntlPrdlst == null)
      ));
    }

    function validAdminOverrides(data) {
      return !('adminOverrides' in data) || (
        data.adminOverrides is map
        && data.adminOverrides.size() == 1
        && validPetDetails(data.adminOverrides.petDetails)
      );
    }

    function validCompleteAdminOverrides(data) {
      let overrides = data.adminOverrides;
      let details = overrides.petDetails;
      return [
          overrides is map,
          overrides.size() == 1,
          details is map,
          details.size() == 9,
          validCompletePetDetails(details)
        ].hasOnly([true]);
    }

    function rootEditableFieldNames() {
      return [
        'name', 'serviceCategory', 'regionArea', 'address', 'roadAddress', 'latitude', 'longitude',
        'phone', 'primaryImageUrl', 'secondaryImageUrl', 'shortDescription', 'fullDescription',
        'parkingInfo', 'businessHours', 'closedDays', 'instagramUrl', 'tags',
        'recommendedPoints', 'cautionNotes'
      ];
    }

    function petPolicyEditableFieldNames() {
      return [
        'petPolicy.petInformationStatus', 'petPolicy.petAcceptance', 'petPolicy.smallDogAllowed',
        'petPolicy.mediumDogAllowed', 'petPolicy.largeDogAllowed', 'petPolicy.indoorAllowed',
        'petPolicy.outdoorAllowed', 'petPolicy.carrierRequired', 'petPolicy.leashRequired',
        'petPolicy.offLeashZoneAvailable', 'petPolicy.allowedBreeds', 'petPolicy.allowedSizes',
        'petPolicy.sizeDescription', 'petPolicy.spacePolicy', 'petPolicy.spaceDescription',
        'petPolicy.leashDescription', 'petPolicy.petFee', 'petPolicy.petFeeDescription',
        'petPolicy.otherPetPolicy'
      ];
    }

    function petDetailsEditableFieldNames() {
      return [
        'petDetails.acmpyTypeCd', 'petDetails.acmpyNeedMtr', 'petDetails.acmpyPsblCpam',
        'petDetails.etcAcmpyInfo', 'petDetails.relaAcdntRiskMtr', 'petDetails.relaFrnshPrdlst',
        'petDetails.relaPosesFclty', 'petDetails.relaPurcPrdlst', 'petDetails.relaRntlPrdlst'
      ];
    }

    function amenitiesEditableFieldNames() {
      return [
        'amenities.freeParking', 'amenities.dogMenu', 'amenities.waterBowlProvided',
        'amenities.wasteBagsProvided', 'amenities.fencedYard', 'amenities.photoZone',
        'amenities.parkingDescription'
      ];
    }

    function allNestedEditableFieldNames() {
      return [
        'petPolicy.petInformationStatus', 'petPolicy.petAcceptance', 'petPolicy.smallDogAllowed',
        'petPolicy.mediumDogAllowed', 'petPolicy.largeDogAllowed', 'petPolicy.indoorAllowed',
        'petPolicy.outdoorAllowed', 'petPolicy.carrierRequired', 'petPolicy.leashRequired',
        'petPolicy.offLeashZoneAvailable', 'petPolicy.allowedBreeds', 'petPolicy.allowedSizes',
        'petPolicy.sizeDescription', 'petPolicy.spacePolicy', 'petPolicy.spaceDescription',
        'petPolicy.leashDescription', 'petPolicy.petFee', 'petPolicy.petFeeDescription',
        'petPolicy.otherPetPolicy', 'petDetails.acmpyTypeCd', 'petDetails.acmpyNeedMtr',
        'petDetails.acmpyPsblCpam', 'petDetails.etcAcmpyInfo', 'petDetails.relaAcdntRiskMtr',
        'petDetails.relaFrnshPrdlst', 'petDetails.relaPosesFclty', 'petDetails.relaPurcPrdlst',
        'petDetails.relaRntlPrdlst', 'amenities.freeParking', 'amenities.dogMenu',
        'amenities.waterBowlProvided', 'amenities.wasteBagsProvided', 'amenities.fencedYard',
        'amenities.photoZone', 'amenities.parkingDescription'
      ];
    }

    function allEditableFieldNames() {
      return [
        'address', 'amenities.dogMenu', 'amenities.fencedYard', 'amenities.freeParking',
        'amenities.parkingDescription', 'amenities.photoZone', 'amenities.wasteBagsProvided',
        'amenities.waterBowlProvided', 'businessHours', 'cautionNotes', 'closedDays',
        'fullDescription', 'instagramUrl', 'latitude', 'longitude', 'name', 'parkingInfo',
        'petDetails.acmpyNeedMtr', 'petDetails.acmpyPsblCpam', 'petDetails.acmpyTypeCd',
        'petDetails.etcAcmpyInfo', 'petDetails.relaAcdntRiskMtr', 'petDetails.relaFrnshPrdlst',
        'petDetails.relaPosesFclty', 'petDetails.relaPurcPrdlst', 'petDetails.relaRntlPrdlst',
        'petPolicy.allowedBreeds', 'petPolicy.allowedSizes', 'petPolicy.carrierRequired',
        'petPolicy.indoorAllowed', 'petPolicy.largeDogAllowed', 'petPolicy.leashDescription',
        'petPolicy.leashRequired', 'petPolicy.mediumDogAllowed',
        'petPolicy.offLeashZoneAvailable', 'petPolicy.otherPetPolicy',
        'petPolicy.outdoorAllowed', 'petPolicy.petAcceptance', 'petPolicy.petFee',
        'petPolicy.petFeeDescription', 'petPolicy.petInformationStatus',
        'petPolicy.sizeDescription', 'petPolicy.smallDogAllowed',
        'petPolicy.spaceDescription', 'petPolicy.spacePolicy', 'phone', 'primaryImageUrl',
        'recommendedPoints', 'regionArea', 'roadAddress', 'secondaryImageUrl',
        'serviceCategory', 'shortDescription', 'tags'
      ];
    }

    function allUserVisibleFieldNames() {
      return [
        'address', 'amenities.dogMenu', 'amenities.fencedYard', 'amenities.freeParking',
        'amenities.parkingDescription', 'amenities.photoZone', 'amenities.wasteBagsProvided',
        'amenities.waterBowlProvided', 'businessHours', 'cautionNotes', 'closedDays',
        'fullDescription', 'instagramUrl', 'latitude', 'longitude', 'name', 'parkingInfo',
        'petDetails.acmpyNeedMtr', 'petDetails.acmpyPsblCpam', 'petDetails.acmpyTypeCd',
        'petDetails.etcAcmpyInfo', 'petDetails.relaAcdntRiskMtr', 'petDetails.relaFrnshPrdlst',
        'petDetails.relaPosesFclty', 'petDetails.relaPurcPrdlst', 'petDetails.relaRntlPrdlst',
        'petPolicy.allowedBreeds', 'petPolicy.allowedSizes', 'petPolicy.carrierRequired',
        'petPolicy.indoorAllowed', 'petPolicy.largeDogAllowed', 'petPolicy.leashDescription',
        'petPolicy.leashRequired', 'petPolicy.mediumDogAllowed',
        'petPolicy.offLeashZoneAvailable', 'petPolicy.otherPetPolicy',
        'petPolicy.outdoorAllowed', 'petPolicy.petAcceptance', 'petPolicy.petFee',
        'petPolicy.petFeeDescription', 'petPolicy.sizeDescription',
        'petPolicy.smallDogAllowed', 'petPolicy.spaceDescription', 'petPolicy.spacePolicy',
        'phone', 'primaryImageUrl', 'recommendedPoints', 'regionArea', 'roadAddress',
        'secondaryImageUrl', 'serviceCategory', 'shortDescription', 'tags'
      ];
    }

    function allTopLevelEditableFieldNames() {
      return [
        'address', 'adminOverrides', 'amenities', 'businessHours', 'cautionNotes', 'closedDays',
        'fullDescription', 'instagramUrl', 'latitude', 'longitude', 'name', 'parkingInfo',
        'petPolicy', 'phone', 'primaryImageUrl', 'recommendedPoints', 'regionArea', 'roadAddress',
        'secondaryImageUrl', 'serviceCategory', 'shortDescription', 'tags'
      ];
    }

    function validNestedChangedFields(changed, changedTopLevel) {
      let policyChanged = changedTopLevel.hasAny(['petPolicy']);
      let detailsChanged = changedTopLevel.hasAny(['adminOverrides']);
      let amenitiesChanged = changedTopLevel.hasAny(['amenities']);
      return policyChanged
        ? (detailsChanged
          ? (amenitiesChanged
            ? changed.hasOnly(allNestedEditableFieldNames())
            : changed.hasOnly(petPolicyEditableFieldNames().toSet()
              .union(petDetailsEditableFieldNames().toSet())))
          : (amenitiesChanged
            ? changed.hasOnly(petPolicyEditableFieldNames().toSet()
              .union(amenitiesEditableFieldNames().toSet()))
            : changed.hasOnly(petPolicyEditableFieldNames())))
        : (detailsChanged
          ? (amenitiesChanged
            ? changed.hasOnly(petDetailsEditableFieldNames().toSet()
              .union(amenitiesEditableFieldNames().toSet()))
            : changed.hasOnly(petDetailsEditableFieldNames()))
          : (amenitiesChanged
            ? changed.hasOnly(amenitiesEditableFieldNames())
            : changed.size() == 0));
    }

    function validPartialChangedFieldNames(changedFields, changedTopLevel) {
      let nestedTopLevel = ['petPolicy', 'amenities', 'adminOverrides'].toSet();
      let changedRootFields = changedTopLevel.difference(nestedTopLevel);
      let changedNestedFields = changedFields.difference(changedRootFields);
      return changedRootFields.hasOnly(rootEditableFieldNames())
        && changedFields.hasAll(changedRootFields)
        && validNestedChangedFields(changedNestedFields, changedTopLevel);
    }

    function petPolicyFactKeys() {
      return [
        'petAcceptance', 'smallDogAllowed', 'mediumDogAllowed', 'largeDogAllowed',
        'indoorAllowed', 'outdoorAllowed', 'carrierRequired', 'leashRequired',
        'offLeashZoneAvailable', 'allowedBreeds', 'allowedSizes', 'sizeDescription',
        'spacePolicy', 'spaceDescription', 'leashDescription', 'petFee',
        'petFeeDescription', 'otherPetPolicy'
      ];
    }

    function clearableRootFieldNames() {
      return [
        'address', 'roadAddress', 'latitude', 'longitude', 'phone', 'primaryImageUrl',
        'secondaryImageUrl', 'shortDescription', 'fullDescription', 'parkingInfo',
        'businessHours', 'closedDays', 'instagramUrl', 'tags', 'recommendedPoints', 'cautionNotes'
      ];
    }

    function stringClearableRootFieldNames() {
      return [
        'address', 'roadAddress', 'phone', 'primaryImageUrl', 'secondaryImageUrl',
        'shortDescription', 'fullDescription', 'parkingInfo', 'businessHours',
        'closedDays', 'instagramUrl'
      ];
    }

    function validSingleClearedValue(data, field) {
      // Every caller has already checked the complete clearable-field allowlist.
      return data[field] == (field in ['latitude', 'longitude'] ? null
        : field in ['tags', 'recommendedPoints', 'cautionNotes'] ? [] : '');
    }

    function validListedClearedValues(data, clearedList) {
      let count = clearedList.size();
      return validSingleClearedValue(data, clearedList[0])
        && (count == 1 || (validSingleClearedValue(data, clearedList[1])
        && (count == 2 || (validSingleClearedValue(data, clearedList[2])
        && (count == 3 || (validSingleClearedValue(data, clearedList[3])
        && (count == 4 || (validSingleClearedValue(data, clearedList[4])
        && (count == 5 || (validSingleClearedValue(data, clearedList[5])
        && (count == 6 || (validSingleClearedValue(data, clearedList[6])
        && (count == 7 || (validSingleClearedValue(data, clearedList[7])
        && (count == 8 || (validSingleClearedValue(data, clearedList[8])
        && (count == 9 || (validSingleClearedValue(data, clearedList[9])
        && (count == 10 || (validSingleClearedValue(data, clearedList[10])
        && (count == 11 || (validSingleClearedValue(data, clearedList[11])
        && (count == 12 || (validSingleClearedValue(data, clearedList[12])
        && (count == 13 || (validSingleClearedValue(data, clearedList[13])
        && (count == 14 || validSingleClearedValue(data, clearedList[14]))
        ))))))))))))))))))))))))));
    }

    function validAllClearedValues(data) {
      return [
          data.address, data.roadAddress, data.phone, data.primaryImageUrl,
          data.secondaryImageUrl, data.shortDescription, data.fullDescription,
          data.parkingInfo, data.businessHours, data.closedDays, data.instagramUrl
        ].hasOnly([''])
        && data.latitude == null
        && data.longitude == null
        && data.tags == []
        && data.recommendedPoints == []
        && data.cautionNotes == [];
    }

    function validManyClearedValues(data, cleared) {
      return [
        !cleared.hasAny(['address']) || data.address == '',
        !cleared.hasAny(['roadAddress']) || data.roadAddress == '',
        !cleared.hasAny(['latitude']) || data.latitude == null,
        !cleared.hasAny(['longitude']) || data.longitude == null,
        !cleared.hasAny(['phone']) || data.phone == '',
        !cleared.hasAny(['primaryImageUrl']) || data.primaryImageUrl == '',
        !cleared.hasAny(['secondaryImageUrl']) || data.secondaryImageUrl == '',
        !cleared.hasAny(['shortDescription']) || data.shortDescription == '',
        !cleared.hasAny(['fullDescription']) || data.fullDescription == '',
        !cleared.hasAny(['parkingInfo']) || data.parkingInfo == '',
        !cleared.hasAny(['businessHours']) || data.businessHours == '',
        !cleared.hasAny(['closedDays']) || data.closedDays == '',
        !cleared.hasAny(['instagramUrl']) || data.instagramUrl == '',
        !cleared.hasAny(['tags']) || data.tags == [],
        !cleared.hasAny(['recommendedPoints']) || data.recommendedPoints == [],
        !cleared.hasAny(['cautionNotes']) || data.cautionNotes == []
      ].hasOnly([true]);
    }

    function validClearedFields(data, clearedList) {
      let cleared = clearedList.toSet();
      return cleared.hasOnly(clearableRootFieldNames())
        && (cleared.size() == 16
          ? validAllClearedValues(data)
          : clearedList.size() <= 15
            && (clearedList.size() > 4 ? validManyClearedValues(data, cleared) : validListedClearedValues(data, clearedList)));
    }

    function validSingleFieldClearedAudit(data, oldData, admin) {
      let clearedList = admin.clearedFields;
      let cleared = clearedList.toSet();
      let oldCleared = 'manualAdmin' in oldData
          && oldData.manualAdmin is map
          && 'clearedFields' in oldData.manualAdmin
          && oldData.manualAdmin.clearedFields is list
        ? oldData.manualAdmin.clearedFields.toSet()
        : [].toSet();
      let changedField = admin.changedFields[0];
      let auditDelta = cleared.difference(oldCleared)
        .union(oldCleared.difference(cleared));
      return clearedList.size() == cleared.size()
        && cleared.hasOnly(clearableRootFieldNames())
        && auditDelta.hasOnly([changedField])
        && (!cleared.hasAny([changedField])
          || validSingleClearedValue(data, changedField));
    }

    function validPetPolicyProvenance(data, oldData) {
      let policy = data.petPolicy;
      let oldPolicy = oldData.petPolicy;
      let policyAffected = policy.diff(oldPolicy).affectedKeys();
      let factsChanged = policyAffected.hasAny(petPolicyFactKeys());
      let statusChanged = policy.petInformationStatus != oldPolicy.petInformationStatus;
      return (factsChanged && policy.petInformationStatus == 'ADMIN_CONFIRMED')
        || (!factsChanged && !statusChanged);
    }

    function validPartialClearedAudit(data, oldData, admin, displayAffected) {
      let cleared = admin.clearedFields.toSet();
      let oldCleared = oldData.get('manualAdmin', {}).get('clearedFields', []).toSet();
      let delta = cleared.difference(oldCleared).union(oldCleared.difference(cleared));
      let touched = cleared.intersection(displayAffected);
      // Unchanged clear fields retain their already-validated stored values.
      // Only changed root fields may add/remove clear metadata.
      return admin.clearedFields.size() == cleared.size()
        && cleared.hasOnly(clearableRootFieldNames())
        && delta.hasOnly(displayAffected)
        && (touched.size() == 0 || validManyClearedValues(data, touched));
    }

    function validPetProvenance(data, oldData, affected) {
      // Any admin override is a pet fact edit, so avoid recomputing the policy diff.
      return affected.hasAny(['adminOverrides'])
        ? data.petPolicy.petInformationStatus == 'ADMIN_CONFIRMED'
        : validPetPolicyProvenance(data, oldData);
    }

    function validCompleteManualAdmin(data, oldData, displayAffected) {
      let admin = data.manualAdmin;
      let changedFields = admin.changedFields.toSet();
      let changedTopLevel = admin.changedTopLevel.toSet();
      let managedFields = admin.managedFields.toSet();
      let oldManagedFields = priorManagedFields(oldData);
      return [
          validAuditEnvelope(admin, oldData),
          admin.source == 'ADMIN_UI',
          admin.updatedAt == request.time,
          (admin.changedFields.size() == 54
          ? admin.changedFields == allEditableFieldNames()
            && managedFields == oldManagedFields.union(changedFields)
          : admin.changedFields.size() == 53
            && admin.changedFields == allUserVisibleFieldNames()
            && admin.managedFields.size() <= 60
            && managedFields == oldManagedFields.union(changedFields)),
          admin.changedTopLevel.size() == changedTopLevel.size(),
          changedTopLevel == displayAffected,
          displayAffected.hasOnly(allTopLevelEditableFieldNames()),
          (admin.clearedFields == [] || (
          admin.clearedFields.size() <= 60
          && validClearedFields(data, admin.clearedFields)
        ))
        ].hasOnly([true]);
    }

    function validPartialManualAdmin(data, oldData, displayAffected) {
      let admin = data.manualAdmin;
      let changedFields = admin.changedFields.toSet();
      let changedTopLevel = admin.changedTopLevel.toSet();
      let managedFields = admin.managedFields.toSet();
      let oldManagedFields = priorManagedFields(oldData);
      return [
          admin is map,
          validAuditEnvelope(admin, oldData),
          admin.source == 'ADMIN_UI',
          admin.updatedAt == request.time,
          admin.changedFields is list,
          admin.changedFields.size() > 0,
          admin.changedFields.size() <= 60,
          admin.changedTopLevel is list,
          admin.changedTopLevel.size() > 0,
          admin.changedTopLevel.size() == changedTopLevel.size(),
          changedTopLevel == displayAffected,
          validPartialChangedFieldNames(changedFields, changedTopLevel),
          admin.clearedFields is list,
          admin.clearedFields.size() <= 60,
          (admin.changedFields.size() == 1
          ? validSingleFieldClearedAudit(data, oldData, admin)
          : validPartialClearedAudit(data, oldData, admin, displayAffected)),
          admin.managedFields is list,
          admin.managedFields.size() <= 60,
          managedFields == oldManagedFields.union(changedFields)
        ].hasOnly([true]);
    }

    function validSearch(data, oldData) {
      let search = data.search;
      let basicScore = search.basicScore;
      let petScore = search.petScore;
      let petTier = search.petTier;
      let petTierRank = petTier == 'RICH' ? 3 : petTier == 'PARTIAL' ? 2 : petTier == 'BASIC' ? 1 : 0;
      return [
          search is map,
          search.size() == 14,
          search.version == 1,
          search.scoreVersion == 'hank-place-field-audit-v1',
          search.region in ['JEJU_CITY', 'SEOGWIPO_CITY', 'EAST', 'WEST', 'UNKNOWN'],
          search.category in ['ATTRACTION', 'CAFE', 'FOOD', 'SHOPPING', 'STAY', 'LEISURE', 'CULTURE', 'EVENT', 'UNKNOWN'],
          search.regionBasis in ['SERVICE_REGION', 'ADDRESS_EAST', 'ADDRESS_WEST', 'MUNICIPALITY', 'UNKNOWN'],
          search.categoryBasis in ['SERVICE_CATEGORY', 'KTO_CONTENT_TYPE', 'KTO_CAT3', 'TITLE_FALLBACK', 'UNKNOWN'],
          basicScore is int,
          (basicScore >= 0 && basicScore <= 15),
          petScore is int,
          (petScore >= 0 && petScore <= 9),
        // Numeric equality permits floats, so preserve the explicit integer check.
          search.totalScore is int,
          search.totalScore == basicScore + petScore,
        // The exhaustive branches below are the petTier enum validation.
          ((petTier == 'RICH' && petScore >= 5)
          || (petTier == 'PARTIAL' && petScore >= 2 && petScore <= 4)
          || (petTier == 'BASIC' && petScore <= 1)
          || (petTier == 'UNKNOWN' && petScore == 0)),
          search.petSortKey == petTierRank * 10000 + petScore * 100 + basicScore,
          search.primarySourceId is string,
          search.primarySourceId == oldData.search.primarySourceId,
        // matches() rejects non-string values while enforcing the exact hash shape.
          search.inputHash.matches('^[a-f0-9]{64}$'),
        // Equality with request.time also enforces the timestamp type.
          search.derivedAt == request.time,
          (!('serviceCategory' in data) || !(data.serviceCategory is string) || search.category == data.serviceCategory),
          (!('regionArea' in data) || !(data.regionArea in ['JEJU_CITY', 'SEOGWIPO_CITY', 'EAST', 'WEST']) || search.region == data.regionArea)
        ].hasOnly([true]);
    }

    function validCompleteSearch(data, oldData) {
      let search = data.search;
      let basicScore = search.basicScore;
      let petScore = search.petScore;
      let petTier = search.petTier;
      let region = search.region;
      let category = search.category;
      let primarySourceId = search.primarySourceId;
      let petTierRank = petTier == 'RICH' ? 3 : petTier == 'PARTIAL' ? 2 : petTier == 'BASIC' ? 1 : 0;
      return [
          search.size() == 14,
          search.version == 1,
          search.scoreVersion == 'hank-place-field-audit-v1',
          region in ['JEJU_CITY', 'SEOGWIPO_CITY', 'EAST', 'WEST', 'UNKNOWN'],
          category in ['ATTRACTION', 'CAFE', 'FOOD', 'SHOPPING', 'STAY', 'LEISURE', 'CULTURE', 'EVENT', 'UNKNOWN'],
          search.regionBasis == 'SERVICE_REGION',
          search.categoryBasis == 'SERVICE_CATEGORY',
          basicScore is int, (basicScore >= 0 && basicScore <= 15),
          petScore is int, (petScore >= 0 && petScore <= 9),
          search.totalScore is int,
          search.totalScore == basicScore + petScore,
          (petTier == 'RICH' && petScore >= 5)
            || (petTier == 'PARTIAL' && petScore >= 2 && petScore <= 4)
            || (petTier == 'BASIC' && petScore <= 1)
            || (petTier == 'UNKNOWN' && petScore == 0),
          search.petSortKey == petTierRank * 10000 + petScore * 100 + basicScore,
          primarySourceId is string,
          primarySourceId == oldData.search.primarySourceId,
          search.inputHash.matches('^[a-f0-9]{64}$'),
          search.derivedAt == request.time,
          category != 'UNKNOWN',
          category == data.serviceCategory,
          region == data.regionArea
        ].hasOnly([true]);
    }

    function validCompleteSecondaryDisplayFields(data) {
      let roadAddress = data.roadAddress;
      let phone = data.phone;
      let shortDescription = data.shortDescription;
      let parkingInfo = data.parkingInfo;
      let businessHours = data.businessHours;
      let closedDays = data.closedDays;
      let tags = data.tags;
      let recommendedPoints = data.recommendedPoints;
      let cautionNotes = data.cautionNotes;
      return [
          roadAddress.matches('(?s)^.{0,500}$'),
          phone.matches('(?s)^.{0,30}$'),
          shortDescription.matches('(?s)^.{0,500}$'),
          parkingInfo.matches('(?s)^.{0,1000}.{0,1000}.{0,1000}.{0,1000}$'),
          businessHours.matches('(?s)^.{0,1000}.{0,1000}.{0,1000}.{0,1000}$'),
          closedDays.matches('(?s)^.{0,500}$'),
          tags is list, tags.size() <= 30,
          recommendedPoints is list, recommendedPoints.size() <= 30,
          cautionNotes is list, cautionNotes.size() <= 30
        ].hasOnly([true]);
    }

    function validCompleteClearedPlaceDisplay(data) {
      // Caller already validated all 16 clear values in validCompleteManualAdmin.
      return [
          data.name.matches('(?s)^.{1,100}$'),
          data.coordinateQualityStatus == 'ADMIN_CONFIRMED',
          data.petPolicy.petInformationStatus == 'ADMIN_CONFIRMED',
          validPetPolicy(data), validAmenities(data), validCompleteAdminOverrides(data)
        ].hasOnly([true]);
    }

    function validCompletePlaceDisplay(data) {
      let name = data.name;
      let address = data.address;
      let primaryImageUrl = data.primaryImageUrl;
      let secondaryImageUrl = data.secondaryImageUrl;
      let instagramUrl = data.instagramUrl;
      let latitude = data.latitude;
      let longitude = data.longitude;
      let fullDescription = data.fullDescription;
      return [
          name.matches('(?s)^.{1,100}$'),
          address.matches('(?s)^.{0,500}$'),
          primaryImageUrl.matches('^(|http://.{1,493}|https://.{1,492})$'),
          secondaryImageUrl.matches('^(|http://.{1,493}|https://.{1,492})$'),
          fullDescription.matches('(?s)^.{0,1000}.{0,1000}.{0,1000}.{0,1000}$'),
          instagramUrl.size() <= 500,
          instagramUrl.matches('^$|^https?://([A-Za-z0-9-]+\\.)*instagram\\.com([/:?#].*)?$'),
          latitude == null || (latitude is number && latitude >= 32.5 && latitude <= 34.2),
          longitude == null || (longitude is number && longitude >= 125.5 && longitude <= 127.2),
          data.coordinateQualityStatus == 'ADMIN_CONFIRMED',
          data.petPolicy.petInformationStatus == 'ADMIN_CONFIRMED',
          validCompleteSecondaryDisplayFields(data)
        ].hasOnly([true])
        && validPetPolicy(data)
        && validAmenities(data)
        && validCompleteAdminOverrides(data);
    }

    function validPartialPlaceDisplay(data, oldData, affected) {
      return [
          data.name is string,
          data.name.size() > 0,
          data.name.size() <= 100,
          (affected.hasAny(['serviceCategory'])
          ? data.serviceCategory is string && data.serviceCategory in ['ATTRACTION', 'CAFE', 'FOOD', 'SHOPPING', 'STAY', 'LEISURE', 'CULTURE', 'EVENT']
          : !('serviceCategory' in data) || data.serviceCategory == null
            || (data.serviceCategory is string && data.serviceCategory in ['ATTRACTION', 'CAFE', 'FOOD', 'SHOPPING', 'STAY', 'LEISURE', 'CULTURE', 'EVENT'])),
          (affected.hasAny(['regionArea'])
          ? data.regionArea is string && data.regionArea in ['JEJU_CITY', 'SEOGWIPO_CITY', 'EAST', 'WEST', 'UNKNOWN']
          : !('regionArea' in data) || data.regionArea == null
            || (data.regionArea is string && data.regionArea in ['JEJU_CITY', 'SEOGWIPO_CITY', 'EAST', 'WEST', 'UNKNOWN'])),
          (data.address == oldData.address || (data.address is string && data.address.size() <= 500)),
          (data.roadAddress == oldData.roadAddress || (data.roadAddress is string && data.roadAddress.size() <= 500)),
          (data.phone == oldData.phone || (data.phone is string && data.phone.size() <= 30)),
          (data.primaryImageUrl == oldData.primaryImageUrl || (data.primaryImageUrl is string && (
          data.primaryImageUrl == '' || (data.primaryImageUrl.size() <= 500 && data.primaryImageUrl.matches('^https?://.+$'))
        ))),
          (data.secondaryImageUrl == oldData.secondaryImageUrl || (data.secondaryImageUrl is string && (
          data.secondaryImageUrl == '' || (data.secondaryImageUrl.size() <= 500 && data.secondaryImageUrl.matches('^https?://.+$'))
        ))),
          (data.shortDescription == oldData.shortDescription || (data.shortDescription is string && data.shortDescription.size() <= 500)),
          (data.fullDescription == oldData.fullDescription || (data.fullDescription is string && data.fullDescription.size() <= 4000)),
          (data.parkingInfo == oldData.parkingInfo || (data.parkingInfo is string && data.parkingInfo.size() <= 4000)),
          (data.businessHours == oldData.businessHours || (data.businessHours is string && data.businessHours.size() <= 4000)),
          (data.closedDays == oldData.closedDays || (data.closedDays is string && data.closedDays.size() <= 500)),
          (data.instagramUrl == oldData.instagramUrl || (data.instagramUrl is string && (
          data.instagramUrl == '' || (data.instagramUrl.size() <= 500
            && data.instagramUrl.matches('^https?://([A-Za-z0-9-]+\\.)*instagram\\.com([/:?#].*)?$'))
        ))),
          (data.tags == oldData.tags || (data.tags is list && data.tags.size() <= 30)),
          (data.recommendedPoints == oldData.recommendedPoints || (data.recommendedPoints is list && data.recommendedPoints.size() <= 30)),
          (data.cautionNotes == oldData.cautionNotes || (data.cautionNotes is list && data.cautionNotes.size() <= 30)),
          ((data.latitude == oldData.latitude && data.longitude == oldData.longitude
          && data.coordinateQualityStatus == oldData.coordinateQualityStatus) || (
          (data.latitude == null || (data.latitude is number && data.latitude >= 32.5 && data.latitude <= 34.2))
          && (data.longitude == null || (data.longitude is number && data.longitude >= 125.5 && data.longitude <= 127.2))
          && data.coordinateQualityStatus == 'ADMIN_CONFIRMED'
        )),
          (!affected.hasAny(['petPolicy']) || validPetPolicy(data)),
          (!affected.hasAny(['amenities']) || validAmenities(data)),
          (!affected.hasAny(['adminOverrides']) || validAdminOverrides(data))
        ].hasOnly([true]);
    }

    function validPlaceUpdate(placeId) {
      let data = request.resource.data;
      let oldData = resource.data;
      let affected = data.diff(oldData).affectedKeys();
      let displayAffected = affected.difference(
        ['manualAdmin', 'search', 'updatedAt', 'coordinateQualityStatus'].toSet()
      );
      return oldData.placeId == placeId
        && data.placeId == placeId
        // Equality with request.time also enforces the timestamp type.
        && data.updatedAt == request.time
        && (displayAffected.size() == 22
          ? validCompleteManualAdmin(data, oldData, displayAffected)
            && (data.manualAdmin.clearedFields.size() == 16 ? validCompleteClearedPlaceDisplay(data) : validCompletePlaceDisplay(data))
            && validCompleteSearch(data, oldData)
          : affected.hasAll(['manualAdmin', 'search', 'updatedAt'])
            && validPartialManualAdmin(data, oldData, displayAffected)
            && (!affected.hasAny(['coordinateQualityStatus'])
              || affected.hasAny(['latitude', 'longitude']))
            && (!affected.hasAny(['petPolicy', 'adminOverrides'])
              || validPetProvenance(data, oldData, affected))
            && validPartialPlaceDisplay(data, oldData, affected)
            && validSearch(data, oldData));
    }

    function priorManagedFields(data) {
      let audit = data.get('manualAdmin', {});
      let legacy = audit.get('changedFields', []).toSet().union(audit.get('clearedFields', []).toSet());
      return 'managedFields' in audit ? audit.managedFields.toSet().union(legacy)
        : legacy.intersection(allEditableFieldNames().toSet().union(['publicationStatus'].toSet()));
    }

    function validAuditEnvelope(admin, oldData) {
      let previous = oldData.get('manualAdmin', {}).get('previousPublicationStatus', null);
      return previous == null
        ? admin.size() == 6 && !('previousPublicationStatus' in admin)
        : admin.size() == 7 && admin.previousPublicationStatus == previous
          && previous in ['DRAFT', 'PUBLISHED'] && oldData.publicationStatus == 'HIDDEN';
    }

    function validPublicationTransition(placeId) {
      let data = request.resource.data;
      let old = resource.data;
      let audit = data.manualAdmin;
      let oldAudit = old.get('manualAdmin', {});
      return old.placeId == placeId && data.placeId == placeId
        && data.diff(old).affectedKeys().hasOnly(['publicationStatus', 'manualAdmin', 'updatedAt'])
        && data.updatedAt == request.time && audit.updatedAt == request.time
        && audit.source == 'ADMIN_UI'
        && audit.changedFields == ['publicationStatus'] && audit.changedTopLevel == ['publicationStatus']
        && audit.managedFields is list && audit.managedFields.size() <= 60
        && audit.managedFields.toSet() == priorManagedFields(old).union(['publicationStatus'].toSet())
        && audit.clearedFields == oldAudit.get('clearedFields', [])
        && (old.publicationStatus in ['DRAFT', 'PUBLISHED']
          ? data.publicationStatus == 'HIDDEN' && audit.size() == 7
            && audit.previousPublicationStatus == old.publicationStatus
          : old.publicationStatus == 'HIDDEN' && audit.size() == 6
            && !('previousPublicationStatus' in audit)
            && oldAudit.previousPublicationStatus in ['DRAFT', 'PUBLISHED']
            && data.publicationStatus == oldAudit.previousPublicationStatus);
    }

    function ownerPlaceId(placeId) {
      return placeId.matches('^owner-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$');
    }

    function validOwnerSourceEnvelope(data, placeId, sourceId) {
      return [
          ownerPlaceId(placeId),
          data.size() == 10,
          data.placeId == placeId,
          data.placeSourceId == sourceId,
          placeId == 'owner-' + data.sourceId,
          sourceId == 'owner-input-' + data.sourceId,
          data.source == 'OWNER_INPUT',
          data.sourceDataset == 'admin-place-create-v1',
          data.sourceUpdatedAt == request.time,
          data.importedAt == request.time,
          data.verifiedAt == null,
          data.verificationStatus == 'UNVERIFIED',
          data.rawReference == null
        ].hasOnly([true]);
    }

    function validOwnerSecondaryDisplay(data) {
      let road = data.roadAddress;
      let phone = data.phone;
      let short = data.shortDescription;
      let parking = data.parkingInfo;
      let hours = data.businessHours;
      let closed = data.closedDays;
      let tags = data.tags;
      let recommended = data.recommendedPoints;
      let caution = data.cautionNotes;
      return [road, phone, short, parking, hours, closed, tags, recommended, caution].hasOnly([null]) || [
        (road == null || road.matches('(?s)^.{0,500}$')), (phone == null || phone.matches('(?s)^.{0,30}$')), (short == null || short.matches('(?s)^.{0,500}$')),
        (parking == null || parking.matches('(?s)^.{0,1000}.{0,1000}.{0,1000}.{0,1000}$')), (hours == null || hours.matches('(?s)^.{0,1000}.{0,1000}.{0,1000}.{0,1000}$')), (closed == null || closed.matches('(?s)^.{0,500}$')),
        tags == null || (tags is list && tags.size() <= 30),
        recommended == null || (recommended is list && recommended.size() <= 30),
        caution == null || (caution is list && caution.size() <= 30)
      ].hasOnly([true]);
    }

    function validOwnerCreateDisplay(data) {
      let name = data.name;
      let address = data.address;
      let image = data.primaryImageUrl;
      let secondary = data.secondaryImageUrl;
      let instagram = data.instagramUrl;
      let latitude = data.latitude;
      let longitude = data.longitude;
      let status = data.petPolicy.petInformationStatus;
      return [
        name.matches('(?s)^.{1,100}$'),
        (address == null || address.matches('(?s)^.{0,500}$')),
        image == null || image.matches('^(|http://.{1,493}|https://.{1,492})$'),
        secondary == null || secondary.matches('^(|http://.{1,493}|https://.{1,492})$'),
        instagram == null || (instagram.size() <= 500 && instagram.matches('^$|^https?://([A-Za-z0-9-]+\\.)*instagram\\.com([/:?#].*)?$')),
        (data.fullDescription == null || data.fullDescription.matches('(?s)^.{0,1000}.{0,1000}.{0,1000}.{0,1000}$')),
        (latitude == null && longitude == null && data.coordinateQualityStatus == 'MISSING')
          || (latitude is number && latitude >= 32.5 && latitude <= 34.2
            && longitude is number && longitude >= 125.5 && longitude <= 127.2 && data.coordinateQualityStatus == 'ADMIN_CONFIRMED'),
        data.regionArea in ['JEJU_CITY', 'SEOGWIPO_CITY', 'EAST', 'WEST'],
        status in ['UNKNOWN', 'ADMIN_CONFIRMED'],
        validOwnerSecondaryDisplay(data), validPetPolicy(data), validAmenities(data), validAdminOverrides(data)
      ].hasOnly([true]);
    }

    function validCreateAudit(data) {
      let audit = data.manualAdmin;
      let fields = audit.changedFields.toSet();
      let top = audit.changedTopLevel.toSet();
      return [
        audit.size() == 6, audit.source == 'ADMIN_UI', audit.updatedAt == request.time,
        audit.managedFields == audit.changedFields, audit.clearedFields == [],
        audit.changedFields.size() == fields.size(), audit.changedTopLevel.size() == top.size(),
        fields.size() == 54
          ? audit.changedFields == allEditableFieldNames() && audit.changedTopLevel == allTopLevelEditableFieldNames()
          : fields.size() < 54 && fields.hasAll(['name', 'regionArea', 'serviceCategory']) && validPartialChangedFieldNames(fields, top)
      ].hasOnly([true]);
    }

    function validOwnerPlaceCreate(placeId) {
      let data = request.resource.data;
      let sourceId = data.search.primarySourceId;
      let sourcePath = /databases/$(database)/documents/places/$(placeId)/sources/$(sourceId);
      let source = getAfter(sourcePath).data;
      return [
          ownerPlaceId(placeId),
          data.placeId == placeId,
          data.keys().hasOnly(allTopLevelEditableFieldNames().concat([
          'placeId', 'publicationStatus', 'municipality', 'coordinateQualityStatus', 'createdAt', 'updatedAt', 'manualAdmin', 'search'
        ])),
          data.publicationStatus == 'PUBLISHED',
          data.municipality == null,
          data.createdAt == request.time,
          data.updatedAt == request.time,
          // The new source must pass its own full envelope rule in this same commit.
          source.placeId == placeId,
          source.placeSourceId == sourceId,
          !exists(sourcePath),
          (data.manualAdmin.changedFields.size() == 54 && data.latitude != null
            ? validCompletePlaceDisplay(data) : validOwnerCreateDisplay(data)),
          // The mandatory Source create validates the parent's audit envelope.
          validCompleteSearch(data, data),
          data.search.regionBasis == 'SERVICE_REGION',
          data.search.categoryBasis == 'SERVICE_CATEGORY',
          ((data.petPolicy.petInformationStatus == 'UNKNOWN' && data.search.petTier == 'UNKNOWN')
          || (data.petPolicy.petInformationStatus == 'ADMIN_CONFIRMED' && data.search.petTier != 'UNKNOWN'))
        ].hasOnly([true]);
    }

    function validOwnerSourceCreate(placeId, sourceId) {
      let parentPath = /databases/$(database)/documents/places/$(placeId);
      let parent = getAfter(parentPath).data;
      return validOwnerSourceEnvelope(request.resource.data, placeId, sourceId)
        && !exists(parentPath) && parent.placeId == placeId && parent.createdAt == request.time
        && parent.search.primarySourceId == sourceId && parent.publicationStatus == 'PUBLISHED'
        && validCreateAudit(parent);
    }

    function publicSource(placeId, sourceId) {
      let parent = get(/databases/$(database)/documents/places/$(placeId)).data;
      let source = resource.data;
      return parent.publicationStatus in ['DRAFT', 'PUBLISHED']
        && parent.placeId == placeId && parent.search.primarySourceId == sourceId
        && source.placeId == placeId && source.placeSourceId == sourceId
        && ((source.source == 'KTO' && placeId.matches('^kto-[0-9]+$'))
          || (source.source == 'OWNER_INPUT' && ownerPlaceId(placeId)
            && placeId == 'owner-' + source.sourceId && sourceId == 'owner-input-' + source.sourceId));
    }

    match /admins/{uid} {
      allow get: if isOwner(uid);
      allow list, create, update, delete: if false;
    }

    match /users/{uid}/favorites/{placeId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasAll(['placeId', 'createdAt'])
        && request.resource.data.keys().hasOnly(['placeId', 'createdAt'])
        && request.resource.data.placeId is string
        && request.resource.data.placeId == placeId
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == request.time;
    }

    match /places/{placeId} {
      allow read: if isActiveAdmin() || resource.data.publicationStatus in ['DRAFT', 'PUBLISHED'];
      allow create: if isActiveAdmin() && validOwnerPlaceCreate(placeId);
      allow delete: if false;
      allow update: if isActiveAdmin()
        && (request.resource.data.publicationStatus != resource.data.publicationStatus
          ? validPublicationTransition(placeId) : validPlaceUpdate(placeId));

      match /sources/{sourceId} {
        allow get: if isActiveAdmin() || publicSource(placeId, sourceId);
        allow list: if isActiveAdmin();
        allow create: if isActiveAdmin() && validOwnerSourceCreate(placeId, sourceId);
        allow update, delete: if false;
      }
    }

    // Rules can validate search shape/arithmetic and a SHA-256-shaped value, but
    // cannot recompute SHA-256 from document inputs. Parity is enforced in tests.
    match /{path=**}/sources/{sourceId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
